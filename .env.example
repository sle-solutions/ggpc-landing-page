# Google Sheet mirror for waitlist signups (see scripts/waitlist-sheet.gs)
WAITLIST_SHEET_URL=
WAITLIST_SHEET_SECRET=

# Order this build (/build/[code]). Checkout stays disabled until STRIPE_SECRET_KEY and the sheet vars are set.
GGPC_API_URL=https://api-production-1e7d.up.railway.app/api
SITE_URL=https://www.ggpc.app
# Set to the WhatsApp Business number in international digits only. Leave blank to hide quote buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Prefer a restricted key (rk_) with only: Checkout Sessions write, PaymentIntents read.
STRIPE_SECRET_KEY=
# Optional, unused today (no client-side Stripe.js; Checkout is hosted).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Lane B affiliate links only. Leave blank until the programmes are approved.
AMAZON_AE_ASSOCIATE_TAG=
NOON_COUPON_CODE=
NOON_LINK_TEMPLATE=
# Preview-only White Friday campaign display. Ignored in Vercel production and production-mode local runs.
WHITE_FRIDAY_PREVIEW=
